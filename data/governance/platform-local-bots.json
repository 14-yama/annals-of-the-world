{
  "meta": {
    "version": "1.5.2",
    "owner": "annals-local-infra",
    "description": "Canonical roster of Annals local bots for the Mac Mini pool. Aggressive KeepAlive Ollama enrich waiters + edges. Grok lane DISABLED. Max 1 Ollama generation.",
    "host": "24 GB unified memory Mac mini",
    "timezone": "America/Port_of_Spain",
    "label_prefix": "com.annals.",
    "docs_ref": "docs/governance/local_bots_mac_mini.md",
    "superstack_sot_ref": "/Users/jeltonmentore/Digital Economy/caricom-connects-superstack/packages/truth-registry/platform-local-bots.json",
    "throughput_targets": {
      "note": "Ollama lane :11434 max 1 gen (enrich/enrich-b/c/d/e/significance serialize). Grok disabled. edges-extract is no-LLM and parallel.",
      "entities_per_hour_target": "80\u2013180 Ollama when Mini quiet",
      "entities_per_hour_floor": "50",
      "enrich_batch": 64,
      "sig_batch": 16,
      "grok_batch": 12,
      "edges_extract_batch": 120,
      "ollama_cadence": "KeepAlive worker (ThrottleInterval 5\u20138s)",
      "idle_gap_max_seconds": 8,
      "sync_entities_per_run": 400,
      "kpi_refresh_minutes": 5,
      "stats_cache_refresh_minutes": 30,
      "queue_refresh_minutes": 3
    },
    "appwrite_cutover": {
      "employ_bots": true,
      "target": "local-docker",
      "endpoint": "http://localhost:8080/v1",
      "project_id": "annals-local",
      "database_id": "annals_world_db",
      "note": "Local Docker Appwrite is the UI + sync target. Cloud merges create-if-missing via merge-cloud bot. New local docs never overwrite/push to cloud.",
      "paused_until_employ": []
    },
    "grok": {
      "env_keys": [
        "XAI_API_KEY",
        "GROK_API_KEY"
      ],
      "model_env": "GROK_MODEL",
      "model_default": "grok-4.7",
      "base_url_env": "XAI_BASE_URL",
      "base_url_default": "https://api.x.ai/v1",
      "note": "Set XAI_API_KEY (or GROK_API_KEY) in ~/.config/annals/env or repo .env. Bots soft-skip (exit 0) when unset \u2014 no crash storms."
    },
    "local_enrichment_mode": {
      "unrestricted": true,
      "note": "Local Docker Appwrite \u2014 enrich/LLM/edges ignore Superstack scrap blackouts. Never modify com.caricom.*"
    },
    "grok_lane": {
      "enabled": false,
      "note": "DISABLED \u2014 local Ollama only (user request)"
    }
  },
  "concurrency": {
    "principle": "Many bot definitions are fine; concurrent RAM/CPU/Ollama use must stay gated. Leave headroom for Cursor/OS and Superstack's two daily media-house scrapers. Grok is cloud \u2014 does not consume Mini GPU/NPU.",
    "max_concurrent_llm": 1,
    "max_concurrent_grok": 0,
    "brief_burst_of_2_llm": false,
    "serialize_enrich_vs_significance": true,
    "max_concurrent_heavy_scan": 1,
    "lanes": {
      "always_on": "bot-server + healthcheck only; never blocked by scrap blackout",
      "ollama": "enrich + enrich-b + enrich-c + significance share exclusive ollama+enrich_sig locks; never overlap (max 1 local LLM)",
      "grok": "enrich-grok + enrich-grok-b + significance-grok + edges-grok share grok lock; may run concurrent with Ollama lane",
      "edges": "edges-extract (+ waiter) \u2014 no LLM; may run beside Ollama/Grok; own lock so queue/audits do not block",
      "light": "queue, kpi, stats-cache, push \u2014 may run beside light OS work; queue/kpi skip live-scraper yield",
      "heavy_scan": "audits + orphan triage \u2014 one at a time; skip during scrap blackout and when scrapers are live",
      "network_write": "sync / seed / merge \u2014 Appwrite writes; skip during scrap blackout"
    },
    "lock_dir": "/tmp/annals-bot-locks",
    "ollama": {
      "host": "http://localhost:11434",
      "model_default": "llama3.2:3b",
      "note": "Annals uses default Ollama on 11434. Superstack news Ollama (11435) is separate when enabled; keep Annals on 11434."
    }
  },
  "superstack_blackout": {
    "description": "Do not interrupt Superstack's ~2 daily media-house scrap bots. Annals heavy/LLM/network bots skip these windows and also yield when those LaunchAgents are actively running.",
    "timezone": "America/Port_of_Spain",
    "protected_scrapers": [
      {
        "id": "media-daily-new-articles",
        "name": "Daily new-article bot",
        "launchd_label": "com.caricom.media-daily-new-articles",
        "cron": "10 18 * * *",
        "timezone": "America/Port_of_Spain",
        "ports": [],
        "ollama": false,
        "note": "6:10pm Port of Spain fresh media-house harvest. Process-heavy scrape; do not compete for RAM/CPU."
      },
      {
        "id": "media-archive-backfill-listing",
        "name": "Archive backfill, shallow houses first",
        "launchd_label": "com.caricom.media-archive-backfill-listing",
        "cron": "35 20 * * *",
        "timezone": "America/Port_of_Spain",
        "ports": [],
        "ollama": false,
        "note": "8:35pm Port of Spain one-house listing backfill."
      }
    ],
    "windows": [
      {
        "id": "daily-harvest",
        "protects": "media-daily-new-articles",
        "start": "18:08",
        "end": "18:25",
        "note": "Minimal RAM buffer around 18:10 harvest. Ollama bots ignore via respect_blackout=false."
      },
      {
        "id": "listing-backfill",
        "protects": "media-archive-backfill-listing",
        "start": "20:33",
        "end": "20:50",
        "note": "Minimal buffer around 20:35 listing. Ollama bots ignore via respect_blackout=false."
      }
    ],
    "also_yield_when_process_matches": [
      "media-daily-new-articles",
      "media-archive-backfill-listing",
      "scrape-media-houses"
    ],
    "never_touch_labels": [
      "com.caricom."
    ]
  },
  "bots": [
