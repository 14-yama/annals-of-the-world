      "id": "bot-server",
      "name": "Local Bot HTTP Server",
      "status": "active",
      "lane": "always_on",
      "role": "Curator command post on port 7474 \u2014 status, manual enrich/sig/queue/sync/push/edges/grok triggers, Ollama + Grok health.",
      "uses_ollama": false,
      "uses_grok": false,
      "script": "scripts/local_bot_server_start.sh",
      "schedule": {
        "kind": "keepalive",
        "enabled": true,
        "note": "KeepAlive + RunAtLoad. Not a cron job."
      },
      "launchd": {
        "label": "com.annals.bot-server",
        "KeepAlive": true,
        "RunAtLoad": true
      }
    },
    {
      "id": "healthcheck",
      "name": "Bot stack healthcheck",
      "status": "active",
      "lane": "always_on",
      "role": "Every 5 minutes: ensure Ollama responds, bot-server listens on 7474, restart server if needed. Does not start the legacy monolithic daemon when discrete launchd bots are installed.",
      "uses_ollama": false,
      "script": "scripts/local_bots/healthcheck.sh",
      "schedule": {
        "cron": "*/5 * * * *",
        "timezone": "America/Port_of_Spain",
        "enabled": true
      },
      "respect_blackout": false
    },
    {
      "id": "enrich",
      "name": "AI Enrichment (Ollama)",
      "status": "active",
      "lane": "ollama",
      "role": "Bulk entity enrichment via local Ollama \u2014 fills Overview/Frameworks/Relationships/Places/Texts facets in detailsJson. Writes git-first; sync/push ship later.",
      "uses_ollama": true,
      "script": "scripts/ai_enrich_autonomous.py",
      "args": [
        "--count",
        "64",
        "--model",
        "ollama",
        "--ollama-model",
        "${OLLAMA_MODEL:-llama3.2:3b}",
        "--lenient",
        "--retry",
        "2"
      ],
      "schedule": {
        "kind": "worker",
        "throttle_seconds": 2,
        "timezone": "America/Port_of_Spain",
        "enabled": true,
        "note": "KeepAlive \u2014 relaunches immediately after each batch. Soft-skips when peer holds ollama lock."
      },
      "retry": {
        "on_failure": 3,
        "backoff_base_seconds": 2,
        "backoff_cap_seconds": 45,
        "soft_skip_sleep_seconds": 1
      },
      "respect_blackout": false,
      "yield_on_scraper_process": false,
      "locks": [
        "ollama",
        "enrich_sig"
      ],
      "launchd": {
        "label": "com.annals.enrich",
        "KeepAlive": true,
        "ThrottleInterval": 2
