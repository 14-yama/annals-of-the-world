# Build reverse lookup: first-occurrence wins
QID_TO_DIVISION: dict[str, tuple[str, str]] = {}
for qid, div_info in INSTITUTION_TYPE_MAP.items():
    if qid not in QID_TO_DIVISION:
        QID_TO_DIVISION[qid] = div_info

