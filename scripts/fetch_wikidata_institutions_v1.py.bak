DEFAULT_GEO = ("Global", "Global", "Global")


def get_country_info(country_qid: str | None) -> tuple[str, str, str]:
    """Return (country_name, region, continent) for a Wikidata Q-ID."""
    if not country_qid:
        return DEFAULT_GEO
    return COUNTRY_INFO.get(country_qid, DEFAULT_GEO)


# ═══════════════════════════════════════════════════════════════════
# Era mapping from year
# ═══════════════════════════════════════════════════════════════════

def year_to_era(year: int | None) -> tuple[str, str]:
    """Map a founding year to (era, eraSlug)."""
    if year is None:
        return ("Classical", "classical")  # safe default for historical institutions
    if year < -3000:
        return ("Prehistoric", "prehistoric")
    if year <= 500:
        return ("Classical", "classical")
    if year <= 1500:
        return ("Medieval", "medieval")
    if year <= 1800:
        return ("Early Modern", "early-modern")
    if year <= 1945:
        return ("Modern", "modern")
    return ("Contemporary", "contemporary")


# ═══════════════════════════════════════════════════════════════════
# Historical Significance Score (1–10)
# ═══════════════════════════════════════════════════════════════════

def compute_significance(
    sitelinks: int,
    founding_year: int | None,
    dissolved_year: int | None,
) -> int:
    """
    Compute a 1–10 historical-significance score.

    Factors
    -------
    1. **Wikipedia sitelinks** (primary — higher = more encyclopaedic coverage)
    2. **Antiquity bonus** — older founding dates add +1 for pre-500 CE, +1 for pre-1000 BCE
    3. **Longevity bonus** — institutions still active today (no dissolved date) get +1

    The raw score is clamped to [1, 10].
    """
    # Base score from sitelinks (0-7 range)
    if sitelinks >= 150:
        score = 8
    elif sitelinks >= 100:
        score = 7
    elif sitelinks >= 70:
        score = 6
    elif sitelinks >= 50:
        score = 5
    elif sitelinks >= 35:
        score = 4
    elif sitelinks >= 20:
        score = 3
    elif sitelinks >= 12:
        score = 2
    else:
        score = 1

    # Antiquity bonus
    if founding_year is not None:
        if founding_year < -1000:
            score += 2        # very ancient (before 1000 BCE)
        elif founding_year < 500:
            score += 1        # classical / ancient

    # Still active bonus
    if dissolved_year is None and founding_year is not None:
        score += 1

    return max(1, min(10, score))


def significance_label(score: int) -> str:
    """Human-readable significance label."""
    if score >= 9:
        return "Landmark"
    if score >= 7:
        return "Major"
    if score >= 5:
        return "Notable"
    if score >= 3:
        return "Moderate"
    return "Minor"


# ═══════════════════════════════════════════════════════════════════
# Helper functions
# ═══════════════════════════════════════════════════════════════════

def parse_year(date_str: str | None) -> int | None:
    """Parse Wikidata date string like '+1642-12-25T00:00:00Z'."""
    if not date_str:
        return None
    m = re.match(r'^([+-]?\d+)', date_str)
    if m:
        return int(m.group(1))
    return None


def format_date_display(date_str: str | None) -> str:
    """Format Wikidata date for display."""
    if not date_str:
        return ""
    m = re.match(r'^([+-]?)(\d+)-(\d{2})-(\d{2})', date_str)
    if not m:
        return ""
    sign, year_s, month, day = m.groups()
    year = int(year_s)
    if sign == "-" or (sign == "+" and year < 0):
        return f"{abs(year)} BCE"
    if year > 0 and year < 100:
        return f"{year} CE"
    if month == "01" and day == "01":
        return f"{year} CE" if year < 1000 else str(year)
    return f"{year}-{month}-{day}"


def make_slug(name: str) -> str:
    """Convert a name to a slug."""
    slug = name.lower().strip()
    slug = re.sub(r'[^\w\s-]', '', slug)
    slug = re.sub(r'[\s_]+', '-', slug)
    slug = re.sub(r'-+', '-', slug)
    return slug.strip('-')[:80]


def qid_from_uri(uri: str | None) -> str | None:
    """Extract Q-ID from a Wikidata URI."""
    if not uri:
        return None
    m = re.search(r'(Q\d+)$', uri)
    return m.group(1) if m else None


def binding_val(row: dict, key: str) -> str | None:
    """Safely extract value from SPARQL binding."""
    b = row.get(key)
    if b and "value" in b:
        return b["value"]
    return None


def get_division(type_qid: str | None) -> tuple[str, str]:
    """Map an institution-type QID to (division_code, division_heading)."""
    if type_qid and type_qid in QID_TO_DIVISION:
        return QID_TO_DIVISION[type_qid]
    return ("310", "Political Institutions")  # fallback


# ═══════════════════════════════════════════════════════════════════
# SPARQL query builder
# ═══════════════════════════════════════════════════════════════════

def build_sparql_query(type_qids: list[str], limit: int = 500) -> str:
    """
    Build SPARQL query fetching institutions of given types.

    Uses direct P31 (instance of) matching for speed, then fetches founding
    date, country, headquarters, founder, image, and Wikipedia article.
    """
    values = " ".join(f"wd:{qid}" for qid in type_qids)
    return f"""
SELECT DISTINCT ?item ?itemLabel ?itemDescription
       ?type ?typeLabel
       ?inception ?dissolved
       ?country
       ?countryLabel
       ?headquartersLabel
       ?founderLabel
       ?image
       ?article
       ?sitelinks
WHERE {{
  VALUES ?type {{ {values} }}
  ?item wdt:P31 ?type .
  ?item wikibase:sitelinks ?sitelinks .
  FILTER(?sitelinks > 8)

  OPTIONAL {{ ?item wdt:P571 ?inception . }}
  OPTIONAL {{ ?item wdt:P576 ?dissolved . }}
  OPTIONAL {{ ?item wdt:P17  ?country . }}
  OPTIONAL {{ ?item wdt:P159 ?headquarters . }}
  OPTIONAL {{ ?item wdt:P112 ?founder . }}
  OPTIONAL {{ ?item wdt:P18  ?image . }}
  OPTIONAL {{
    ?article schema:about ?item ;
             schema:isPartOf <https://en.wikipedia.org/> .
  }}

  SERVICE wikibase:label {{ bd:serviceParam wikibase:language "en" . }}
}}
ORDER BY DESC(?sitelinks)
LIMIT {limit}
"""


def fetch_sparql(query: str, retries: int = 3) -> list[dict[str, Any]]:
    """Execute a SPARQL query against Wikidata with retry + rate-limit handling."""
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/sparql-results+json",
    }
    for attempt in range(retries):
        try:
            resp = requests.get(
                SPARQL_ENDPOINT,
                params={"query": query, "format": "json"},
                headers=headers,
                timeout=180,
            )
            if resp.status_code == 429:
                wait = min(90, 15 * (attempt + 1))
                print(f"  Rate limited, waiting {wait}s ...")
                time.sleep(wait)
                continue
            if resp.status_code == 500:
                # Wikidata sometimes 500s on heavy queries — retry
                wait = 20 * (attempt + 1)
                print(f"  Server error 500, retrying in {wait}s ...")
                time.sleep(wait)
                continue
            resp.raise_for_status()
            return resp.json()["results"]["bindings"]
        except requests.exceptions.ReadTimeout:
            wait = 30 * (attempt + 1)
            print(f"  Timeout (attempt {attempt + 1}), retrying in {wait}s ...")
            time.sleep(wait)
        except requests.exceptions.RequestException as e:
            print(f"  Request error (attempt {attempt + 1}): {e}")
            if attempt < retries - 1:
                time.sleep(10 * (attempt + 1))
    return []


# ═══════════════════════════════════════════════════════════════════
# Entity transformer
# ═══════════════════════════════════════════════════════════════════

def transform_institution(row: dict) -> dict[str, Any] | None:
    """Transform a SPARQL result row into an Annals Institution entity dict."""
    item_uri = binding_val(row, "item")
    name = binding_val(row, "itemLabel")
    if not item_uri or not name:
        return None

    # Skip entries where label is just the QID (no English label)
    if re.match(r'^Q\d+$', name):
        return None

    qid = qid_from_uri(item_uri)
    description = binding_val(row, "itemDescription") or ""
    type_qid = qid_from_uri(binding_val(row, "type"))
    type_label = binding_val(row, "typeLabel") or ""
    inception_raw = binding_val(row, "inception")
    dissolved_raw = binding_val(row, "dissolved")
    country_qid = qid_from_uri(binding_val(row, "country"))
    country_label = binding_val(row, "countryLabel") or ""
    headquarters = binding_val(row, "headquartersLabel") or ""
    founder = binding_val(row, "founderLabel") or ""
    image_url = binding_val(row, "image") or ""
    wiki_url = binding_val(row, "article") or ""

    # Sitelinks (for significance scoring)
    sitelinks_raw = binding_val(row, "sitelinks")
    sitelinks = int(sitelinks_raw) if sitelinks_raw else 0

    # Parse dates
    founding_year = parse_year(inception_raw)
    dissolved_year = parse_year(dissolved_raw)
    founded_display = format_date_display(inception_raw)
    dissolved_display = format_date_display(dissolved_raw)

    # Era from founding year
    era, era_slug = year_to_era(founding_year)

    # Division from type
    div_code, div_heading = get_division(type_qid)

    # Country / Region / Continent
    country_name, region, continent = get_country_info(country_qid)
    # If we got a label from Wikidata but no QID match, use the label
    if country_name == "Global" and country_label and not re.match(r'^Q\d+$', country_label):
        country_name = country_label

    # Slug
    slug = make_slug(name)

    # Summary
    summary = description.capitalize() if description else f"{name}, a {type_label}."
    if headquarters:
        summary += f" Headquartered in {headquarters}."
    elif country_name != "Global":
        summary += f" Located in {country_name}."
    if founding_year:
        if founding_year < 0:
            summary += f" Founded c. {abs(founding_year)} BCE."
        else:
            summary += f" Founded {founding_year}."
    if dissolved_year:
        if dissolved_year < 0:
            summary += f" Dissolved c. {abs(dissolved_year)} BCE."
        else:
            summary += f" Dissolved {dissolved_year}."

    # Historical significance score
    sig_score = compute_significance(sitelinks, founding_year, dissolved_year)
    sig_label = significance_label(sig_score)

    # Active status
    is_active = dissolved_year is None

    # Build entity
    entity: dict[str, Any] = {
        "slug": slug,
        "name": name,
        "label": "Institution",
        "callNumber": f"{div_code}.{slug}",
        "subjectHeadings": [f"Institutions — {div_heading} — {country_name} — {era}"],
        "subjects": [
            s for s in [country_name, type_label, continent, div_heading]
            if s and s != "Global"
        ],
        "summary": summary[:9900],
        "era": era,
        "eraSlug": era_slug,
        "region": region,
        "continent": continent,
        "status": "Published",
        "frameworks": ["CAUSE_AND_EFFECT"],
        "causes": [],
        "effects": [],
        "relationships": [
            {
                "sourceSlug": slug,
                "sourceName": name,
                "verb": "OCCURS_IN",
                "targetSlug": (
                    f"country-{make_slug(country_name)}"
                    if country_name != "Global" else ""
                ),
                "targetName": country_name,
                "context": f"{name} located in {country_name}",
            }
        ],
        "places": [],
        "texts": [],
        # ── Institution-specific fields ──
        "institutionType": type_label,
        "divisionCode": div_code,
        "divisionHeading": div_heading,
        "isActive": is_active,
        # ── Historical significance ──
        "historicalSignificance": {
            "score": sig_score,
            "label": sig_label,
            "sitelinks": sitelinks,
        },
        # ── Appwrite seeding flag ──
        "inAppwrite": False,
    }

    # Optional fields
    if founded_display:
        entity["founded"] = founded_display
    if founding_year:
        entity["foundedYear"] = founding_year
    if dissolved_display:
        entity["dissolved"] = dissolved_display
    if dissolved_year:
        entity["dissolvedYear"] = dissolved_year
    if headquarters:
        entity["headquarters"] = headquarters
        entity["places"].append({"name": headquarters, "role": "Headquarters"})
    if founder and not re.match(r'^Q\d+$', founder):
        entity["founder"] = founder
    if country_name and country_name != "Global":
        entity["places"].append({"name": country_name, "role": "Country"})

    # Wikidata metadata
    if qid:
        entity["wikidataQid"] = qid
    if wiki_url:
        entity["wikipediaUrl"] = wiki_url
    if image_url:
        entity["imageUrl"] = image_url

    return entity


# ═══════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description="Fetch notable institutions from Wikidata"
    )
    parser.add_argument(
        "--limit", type=int, default=500,
        help="Max results per type-batch SPARQL query (default: 500)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Print SPARQL queries without executing",
    )
    parser.add_argument(
        "--output", type=str, default=None,
        help="Output JSON file path",
    )
    args = parser.parse_args()

    # Output path
    project_root = Path(__file__).resolve().parent.parent
    output_path = (
        Path(args.output) if args.output
        else project_root / "data" / "wikidata_institutions.json"
    )

    print("=" * 70)
    print("  Wikidata Institutions Fetch — Annals of the World")
    print("=" * 70)
    print(f"  Limit per batch:   {args.limit}")
    print(f"  Output:            {output_path}")
    print(f"  Type batches:      {len(INSTITUTION_QUERIES)}")
    print(f"  Division coverage: 310-394 (9 major groups, 36 sub-divisions)")
    print()

    all_entities: list[dict[str, Any]] = []
    seen_slugs: set[str] = set()
    total_raw = 0

    for batch_name, type_qids in INSTITUTION_QUERIES.items():
        print(f"[{batch_name}]  Querying {len(type_qids)} type(s) ...")
        query = build_sparql_query(type_qids, limit=args.limit)

        if args.dry_run:
            print(f"  (dry-run) SPARQL query for {batch_name}:")
            print(query[:300] + " ...\n")
            continue

        rows = fetch_sparql(query)
        total_raw += len(rows)
        print(f"  Got {len(rows)} raw results")

        batch_count = 0
        for row in rows:
            entity = transform_institution(row)
            if not entity:
                continue
            # Deduplicate by slug
            if entity["slug"] in seen_slugs:
                continue
            seen_slugs.add(entity["slug"])
            all_entities.append(entity)
            batch_count += 1

        print(f"  → {batch_count} unique entities added (total so far: {len(all_entities)})")
        # Be polite to Wikidata — pause between batches
        time.sleep(3)

    if args.dry_run:
        print("\nDry run complete — no data fetched.")
        return

    # ── Sort by era then name ──
    era_order = {
        "Prehistoric": 0, "Classical": 1, "Medieval": 2,
        "Early Modern": 3, "Modern": 4, "Contemporary": 5,
    }
    all_entities.sort(key=lambda e: (era_order.get(e["era"], 9), e["name"]))

    # ── Compute statistics ──
    div_counts: dict[str, int] = {}
    era_counts: dict[str, int] = {}
    sig_dist: dict[str, int] = {}
    continent_counts: dict[str, int] = {}
    for e in all_entities:
        div = e["callNumber"][:3]
        div_counts[div] = div_counts.get(div, 0) + 1
        era_counts[e["era"]] = era_counts.get(e["era"], 0) + 1
        sl = e["historicalSignificance"]["label"]
        sig_dist[sl] = sig_dist.get(sl, 0) + 1
        ct = e.get("continent", "Global")
        continent_counts[ct] = continent_counts.get(ct, 0) + 1

    # ── Write JSON ──
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_data = {
        "_meta": {
            "source": "Wikidata SPARQL (query.wikidata.org)",
            "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "total_raw_results": total_raw,
            "total_unique_entities": len(all_entities),
            "label": "Institution",
            "classCode": 3,
            "classHeading": "Institutions",
            "division_counts": dict(sorted(div_counts.items())),
            "era_counts": dict(sorted(era_counts.items())),
            "significance_distribution": dict(sorted(sig_dist.items())),
            "continent_counts": dict(sorted(continent_counts.items())),
            "significance_scale": {
                "1-2": "Minor — documented but limited global impact",
                "3-4": "Moderate — nationally significant",
                "5-6": "Notable — regionally or thematically important",
                "7-8": "Major — globally recognized",
                "9-10": "Landmark — world-shaping institution",
            },
            "inAppwrite_note": (
                "All entities have inAppwrite=false. Use historicalSignificance.score "
                "to prioritize high-significance institutions for Appwrite seeding."
            ),
            "note": (
                "Each entity follows the Annals of the World Entity schema "
                "(Institution label, Class 3 divisions 310-394)"
            ),
        },
        "entities": all_entities,
    }
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(output_data, f, indent=2, ensure_ascii=False)

    # ── Report ──
    print()
    print("=" * 70)
    print("  Fetch Complete")
    print("=" * 70)
    print(f"  Raw results:       {total_raw}")
    print(f"  Unique entities:   {len(all_entities)}")
    print(f"  Output:            {output_path}")
    print()
    print("  By division:")
    for div, count in sorted(div_counts.items()):
        print(f"    {div}: {count}")
    print()
    print("  By era:")
    for era_name, count in sorted(era_counts.items(), key=lambda x: era_order.get(x[0], 9)):
        print(f"    {era_name}: {count}")
    print()
    print("  By significance:")
    for label, count in sorted(sig_dist.items()):
        print(f"    {label}: {count}")
    print()
    print("  By continent:")
    for ct, count in sorted(continent_counts.items(), key=lambda x: -x[1]):
        print(f"    {ct}: {count}")
    print()

    # Quick top-10 most significant
    top10 = sorted(
        all_entities,
        key=lambda e: (-e["historicalSignificance"]["score"], e["name"]),
    )[:10]
    print("  Top 10 by historical significance:")
    for i, e in enumerate(top10, 1):
        sig = e["historicalSignificance"]
        print(f"    {i:2d}. [{sig['score']:2d} {sig['label']:>8s}] {e['name']}")


if __name__ == "__main__":
    main()
