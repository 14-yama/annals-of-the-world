#!/usr/bin/env python3
"""
fetch_wikidata_institutions.py

Fetches notable historical and modern institutions from the Wikidata SPARQL
endpoint and maps them into the Annals of the World entity schema
(Institution label, Class 3 divisions).

Adds a `historicalSignificance` score (1–10) based on Wikipedia sitelinks,
founding antiquity, and active-status longevity.

Output: data/wikidata_institutions.json  —  ready for catalog integration.

Usage:
    python3 scripts/fetch_wikidata_institutions.py
    python3 scripts/fetch_wikidata_institutions.py --limit 500
    python3 scripts/fetch_wikidata_institutions.py --dry-run
"""

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path
from typing import Any

import requests

# ── Wikidata SPARQL endpoint ──
SPARQL_ENDPOINT = "https://query.wikidata.org/sparql"
USER_AGENT = (
    "AnnalsOfTheWorld/1.0 "
    "(https://github.com/annals-of-the-world; contact@annals.dev)"
)

