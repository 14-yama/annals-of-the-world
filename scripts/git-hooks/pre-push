#!/usr/bin/env bash
# Pre-push failsafe: validate all GitHub Actions workflow YAML.
# Installed at .git/hooks/pre-push by scripts/install_git_hooks.sh.
# Blocks the push if any workflow has invalid YAML — preventing the cloud bot
# outage we had on 2026-05-17 when 4 workflows died from heredoc indentation bugs.

set -e
RED='\033[0;31m'; GREEN='\033[0;32m'; YEL='\033[1;33m'; NC='\033[0m'

# Only run validation if any workflow file is in the push range
PUSHING_WORKFLOWS=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -q '^\.github/workflows/.*\.ya\?ml$'; then
    PUSHING_WORKFLOWS=1
  fi
done

if [ "$PUSHING_WORKFLOWS" = "0" ]; then
  exit 0
fi

echo -e "${YEL}[pre-push] Validating GitHub Actions workflow YAML...${NC}"

FAILED=0
for f in .github/workflows/*.yml .github/workflows/*.yaml; do
  [ -f "$f" ] || continue
  if python3 -c "import yaml,sys; yaml.safe_load(open('$f').read())" 2>/tmp/yaml_err; then
    echo -e "  ${GREEN}✓${NC} $f"
  else
    echo -e "  ${RED}✗${NC} $f"
    sed 's/^/      /' /tmp/yaml_err
    FAILED=1
  fi
done

if [ "$FAILED" = "1" ]; then
  echo ""
  echo -e "${RED}[pre-push] BLOCKED: workflow YAML is invalid.${NC}"
  echo -e "${YEL}Fix the errors above. To bypass (NOT RECOMMENDED): git push --no-verify${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-push] All workflow YAML files valid.${NC}"
exit 0
