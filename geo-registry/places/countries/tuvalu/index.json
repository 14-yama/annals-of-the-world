    "ethnic_groups": [
      {
        "name": "Tuvaluan (Polynesian)",
        "percentage": 96.0,
        "notes": "Polynesian; closely related to Samoans/Tongans; extremely homogeneous; nine inhabited atolls (Tuvalu means 'eight standing together', originally 8 inhabited, Niulakita added); te ano (traditional ball game, entire island participates); fatele (song-dance, community performance); communal living; subsistence (fishing, coconut, pulaka/taro pit cultivation); aliki (chiefs, hereditary, village governance); some of most isolated communities on Earth"
      },
      {
        "name": "Gilbertese (I-Kiribati)",
