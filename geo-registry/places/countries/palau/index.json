    "ethnic_groups": [
      {
        "name": "Palauan",
        "percentage": 73.0,
        "notes": "Micronesian/Melanesian mixed ancestry; matrilineal (women control land and money, clan mothers select chiefs, unique in Pacific); bai (traditional meeting house, elaborate storyboard carvings, UNESCO); stone money connection (Yapese quarried limestone from Palau, historical trade); complex ranked clan system; betel nut (buuch, universal social custom); traditional fishing/taro culture; first-born women hold special economic/political power"
      },
      {
        "name": "Filipino",
        "percentage": 15.3,
        "notes": "Largest foreign group; construction/service workers; labour migration; economically important; some integration issues"
