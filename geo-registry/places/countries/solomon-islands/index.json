    "ethnic_groups": [
      {
        "name": "Melanesian",
        "percentage": 94.5,
        "notes": "Diverse Melanesian peoples; 74 languages; wantok system (kinship obligation); kastom (traditional customs, land tenure, dispute resolution); headhunting historically practiced (ended early 20th century, skull houses preserved/tourist sites); betel nut universal; shell money (strings of shell discs, still used for bride price/traditional transactions, parallel economy); Big Man system (achieved status, not hereditary like Polynesian chiefs); subsistence gardening (sweet potato, taro, yam); canoe culture"
      },
      {
        "name": "Polynesian",
        "percentage": 3.0,
        "notes": "Polynesian outliers: Rennell and Bellona (~3k, distinct Polynesian culture in Melanesian sea, East Rennellese UNESCO); Ontong Java; Tikopia (~1.2k, studied by Raymond Firth, population control, unique society); Sikaiana; Anuta (smallest Polynesian society, ~300 people)"
      },
      {
        "name": "Micronesian",
        "percentage": 1.2,
        "notes": "Gilbertese settlers (relocated from overpopulated Gilbert Islands during British administration); small communities"
      },
      {
        "name": "Other",
        "percentage": 1.3,
        "notes": "Chinese (~2k, targeted in 2006 Chinatown riots Honiara, business community, resentment); European/Australian (mining, logging, aid workers); Bougainvillean (refugees, shared culture with western Solomons)"
      }
