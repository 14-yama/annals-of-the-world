    "ethnic_groups": [
      {
        "name": "Chuukese",
        "percentage": 48.8,
        "notes": "Largest state by population (~48k); Austronesian; Chuuk Lagoon (former Truk, WWII Japanese naval base, 'Ghost Fleet' wreck diving); breadfruit culture; navigation traditions; outmigration to Guam/Hawaii/US mainland significant; inter-island tensions; sovereign state identity within federation"
      },
      {
        "name": "Pohnpeian",
        "percentage": 24.2,
        "notes": "Pohnpei Island (largest); Nan Madol (megalithic basalt city ~1200-1500 CE, 'Venice of the Pacific', UNESCO, one of most remarkable archaeological sites in Pacific); sakau/kava ceremony (central to social hierarchy); Saudeleur dynasty (legendary, built Nan Madol); federal capital Palikir located in Pohnpei"
      },
      {
        "name": "Kosraean",
        "percentage": 6.2,
        "notes": "Smallest state; Polynesian influences; Lelu Ruins (stone city, rival to Nan Madol); strongly Protestant/Congregational; conservative; 'Island of the Sleeping Lady' (mountain silhouette)"
      },
      {
        "name": "Yapese",
        "percentage": 5.2,
        "notes": "Unique culture; rai (stone money, massive limestone discs quarried from Palau, up to 4m diameter, value based on history not size, still used for traditional transactions, inspirational for blockchain/Bitcoin analogy); caste system; betel nut culture; traditional navigation (Carolinian stick charts, star paths); outer islands (Ulithi, Woleai, culturally distinct Carolinian navigators)"
      },
      {
        "name": "Other",
        "percentage": 15.6,
        "notes": "Outer island Carolinians (Ulithian, Woleaian, Satawalese, master navigators, traditional canoe voyaging revived); Polynesian outliers (Nukuoro, Kapingamarangi); Filipino; American; Japanese (WWII legacy); significant diaspora in US (~40k COFA migrants, Guam/Hawaii/Arkansas/Oregon)"
      }
